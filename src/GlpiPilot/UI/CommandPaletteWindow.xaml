<UserControl x:Class="GlpiPilot.UI.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="300" MinHeight="240">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,16">
                <TextBlock Text="Que voulez-vous faire ?" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="Une action, un écran, un raccourci." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Fermer" Click="Close_Click" Style="{StaticResource QuietButton}" VerticalAlignment="Top"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <TextBox x:Name="QueryBox" FontSize="15" Padding="13,11" AutomationProperties.Name="Rechercher une action"/>
            <TextBlock Text="Rechercher une action…" Foreground="{DynamicResource MutedBrush}" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </Grid>
        <Grid Grid.Row="2">
            <ListBox x:Name="ActionsList" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Actions disponibles">
                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="IsEnabled" Value="{Binding Available}"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="8,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,10,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Shortcut}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoActionText" Text="Aucune action ne correspond à la recherche." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="CountText" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="2,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
