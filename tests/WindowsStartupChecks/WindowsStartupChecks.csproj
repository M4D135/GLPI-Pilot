<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>GlpiPilot.WindowsStartupChecks.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GlpiPilot/GlpiPilot.csproj" />
    <EmbeddedResource Include="../../src/GlpiPilot/App.xaml"
                      LogicalName="GlpiPilot.WindowsStartupChecks.ProductionApp.xaml" />
  </ItemGroup>
</Project>
